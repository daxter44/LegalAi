<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-PrawoRAG.Ingestion-4af6f539-af9e-45a1-9488-2b8a3627dff5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Magazyn surowych (data/raw/{SAOS,ELI,NSA}) — lokalny cache, w .gitignore, MILIONY plików
         (NSA: 1,25 mln po pełnym fetchu). Bez wykluczenia domyślne globowanie SDK-style ("None"
         obejmuje WSZYSTKO w katalogu projektu) wciąga je w KAŻDĄ ewaluację MSBuild — restore/build/
         clean liczą się w minutach zamiast sekundach. Ten katalog nigdy nie był częścią builda. -->
    <Compile Remove="data/**" />
    <None Remove="data/**" />
    <Content Remove="data/**" />
    <EmbeddedResource Remove="data/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrawoRAG.Domain\PrawoRAG.Domain.csproj" />
    <ProjectReference Include="..\PrawoRAG.Storage\PrawoRAG.Storage.csproj" />
    <ProjectReference Include="..\PrawoRAG.Embeddings\PrawoRAG.Embeddings.csproj" />
  </ItemGroup>
</Project>
