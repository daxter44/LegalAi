@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<PrawoRAG.Api.Services.AnalysisOptions> Analysis
@inject Microsoft.Extensions.Options.IOptions<PrawoRAG.Api.Services.Auth.AuthOptions> Auth
@inject Microsoft.Extensions.Options.IOptions<PrawoRAG.Api.Services.Billing.BillingOptions> Billing
@inject PrawoRAG.Api.Services.ICurrentUser CurrentUser
@inject NavigationManager Nav

@* JEDEN globalny header na wszystkich stronach (spójność 2026-09-01) — ciemny pasek w stylu
   nawigacji landingu (gradientowy znak, marka display). Ekrany robocze (czat, analiza) też go
   dostają — ich powłoka (sidebar + treść) żyje w app-main-flush POD headerem i scrolluje
   wewnątrz kolumn. Linki i warunki flag NIETKNIĘTE względem stanu sprzed redesignu (inwarianty
   RED). Wyszukiwarka celowo BEZ pozycji w nawigacji (decyzja 2026-08-31: funkcja do dopracowania;
   trasa /szukaj zostaje dostępna z adresu). *@
<div class="app-shell">
    <header class="app-header">
        @* /start, nie "/" — "/" dla zalogowanego przekierowuje do /czat, a logo ma jawnie
           wracać na stronę główną (leftover 2026-08-31). *@
        <a class="app-brand" href="/start" title="Strona główna">
            <span class="app-logo-mark" aria-hidden="true"></span>
            <span class="app-title">OmniaSI</span>
        </a>
        <nav class="app-nav">
            <a href="/czat" class="@ActiveClass("/czat")">Czat</a>
            @if (Analysis.Value.Enabled)
            {
                <a href="/analiza" class="@ActiveClass("/analiza")">Analiza</a>
            }
            <a href="/o-systemie" class="@ActiveClass("/o-systemie")">O systemie</a>
            @if (CurrentUser.IsAuthenticated)
            {
                @if (Billing.Value.Enabled)
                {
                    <a href="/konto">Konto</a>
                }
                <span class="app-user" title="@CurrentUser.DisplayName">@CurrentUser.DisplayName</span>
                @* Zwykły odnośnik: pod /wylogowanie jest strona z potwierdzeniem, a samo wylogowanie
                   dzieje się POST-em z tokenem (GET-owe wylogowanie da się wywołać z obcej strony). *@
                <a href="@(Auth.Value.Enabled ? "/wylogowanie" : "/wyjscie")">Wyloguj</a>
            }
        </nav>
    </header>
    <main class="app-main @(IsAppShellPage ? "app-main-flush" : null)">
        @Body
    </main>
</div>

@code {
    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');

    private bool IsAppShellPage => CurrentPath is "/czat" or "/analiza";

    private string? ActiveClass(string path) => CurrentPath == path ? "active" : null;
}
