@inherits LayoutComponentBase
@inject Microsoft.Extensions.Options.IOptions<PrawoRAG.Api.Services.AnalysisOptions> Analysis
@inject Microsoft.Extensions.Options.IOptions<PrawoRAG.Api.Services.Auth.AuthOptions> Auth
@inject Microsoft.Extensions.Options.IOptions<PrawoRAG.Api.Services.Billing.BillingOptions> Billing
@inject PrawoRAG.Api.Services.ICurrentUser CurrentUser

<div class="app-shell">
    <header class="app-header">
        <a class="app-brand" href="/" title="Strona główna">
            <span class="app-logo">§</span>
            <span class="app-title">PrawoRAG</span>
            <span class="app-tag">demo</span>
        </a>
        <nav class="app-nav">
            <a href="/czat">Czat</a>
            <a href="/szukaj">Wyszukiwarka</a>
            @if (Analysis.Value.Enabled)
            {
                <a href="/analiza">Analiza dokumentów</a>
            }
            <a href="/o-systemie">O systemie</a>
            @if (CurrentUser.IsAuthenticated)
            {
                @if (Billing.Value.Enabled)
                {
                    <a href="/konto">Konto</a>
                }
                <span class="app-user" title="@CurrentUser.DisplayName">@CurrentUser.DisplayName</span>
                @* Zwykły odnośnik: pod /wylogowanie jest strona z potwierdzeniem, a samo wylogowanie
                   dzieje się POST-em z tokenem (GET-owe wylogowanie da się wywołać z obcej strony). *@
                <a href="@(Auth.Value.Enabled ? "/wylogowanie" : "/wyjscie")">Wyloguj</a>
            }
        </nav>
    </header>
    <main class="app-main">
        @Body
    </main>
</div>
